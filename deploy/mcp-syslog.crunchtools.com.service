[Unit]
Description=Podman container - mcp-syslog (MCP Syslog Server)
Documentation=https://github.com/crunchtools/mcp-syslog
Wants=network-online.target
After=network-online.target syslog.crunchtools.com.service

[Service]
Type=simple
Restart=always
RestartSec=10
ExecStartPre=/usr/bin/sleep 1.5
ExecStartPre=-/usr/bin/podman rm -f mcp-syslog
# The log mount is read-only. This server never writes, and a bug here must not
# be able to destroy the forensic record it exists to protect.
ExecStart=/usr/bin/podman run \
    --label io.containers.autoupdate=registry \
    --label PODMAN_SYSTEMD_UNIT=mcp-syslog.crunchtools.com.service \
    --memory=512m --memory-swap=512m \
    --rm \
    --name mcp-syslog \
    --network crunchtools \
    -p 127.0.0.1:8027:8027 \
    -e SYSLOG_LOG_ROOT=/logs \
    -v /srv/syslog.crunchtools.com/data/logs:/logs:ro,z \
    quay.io/crunchtools/mcp-syslog:latest \
    --transport streamable-http --host 0.0.0.0 --port 8027
ExecStop=/usr/bin/podman stop -t 10 mcp-syslog
ExecStopPost=/usr/bin/podman rm -f mcp-syslog

[Install]
WantedBy=multi-user.target
